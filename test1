  var f=$('printFrame');
  f.srcdoc='<!DOCTYPE html><html><head><style>@page{size:A4;margin:8mm}body{margin:0;display:flex;justify-content:center}img{width:170mm;max-width:100%}</style></head><body><img src="'+printableURL+'"></body></html>';
  f.onload=function(){setTimeout(function(){try{f.contentWindow.focus();f.contentWindow.print();}catch(e){toast('Cetak manual: unduh PNG lalu print','err');}},350);};
});
