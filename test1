  x.save(); x.translate(470,330); x.rotate(Math.PI/2); x.font='700 22px Arial'; x.fillStyle='#7A4A22'; x.fillText('KIDI·DKV',0,0); x.restore();
}
function processGrayContrast(){
  var x=markerCanvas.getContext('2d'),d=x.getImageData(0,0,512,512),p=d.data;
