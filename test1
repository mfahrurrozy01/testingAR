window.addEventListener('resize',function(){if(S.mode==='ar')arResize();else sizeStudio();});
if(window.ResizeObserver) new ResizeObserver(function(){if(S.mode==='ar')arResize();else sizeStudio();}).observe(stage);
sizeStudio();

/* ================= SCREENSHOT ================= */
function screenshot(){
  renderer.render(scene,S.mode==='ar'?arCam:studioCam);
  var w=stage.clientWidth,h=stage.clientHeight,c=document.createElement('canvas');
  c.width=w*2;c.height=h*2; var x=c.getContext('2d'); x.scale(2,2);
