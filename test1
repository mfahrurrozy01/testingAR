}
function buildPatt(){
  var c=document.createElement('canvas'); c.width=c.height=16; var x=c.getContext('2d');
  x.imageSmoothingEnabled=true; x.imageSmoothingQuality='high';
  var out='';
  for(var o=0;o<4;o++){
    x.save(); x.fillStyle='#fff'; x.fillRect(0,0,16,16);
    x.translate(8,8); x.rotate(o*Math.PI/2); x.drawImage(markerCanvas,-8,-8,16,16); x.restore();
    var d=x.getImageData(0,0,16,16).data;
    for(var ch=0;ch<3;ch++){
      for(var y=0;y<16;y++){
        var row=[];
        for(var xx=0;xx<16;xx++) row.push(d[(y*16+xx)*4+ch]);
        out+=row.join(' ')+'\n';
      }
    }
