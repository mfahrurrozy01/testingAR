  if(sd>50){q.className='qchip good';q.textContent='Kontras: baik ('+Math.round(sd)+')';}
  else if(sd>28){q.className='qchip mid';q.textContent='Kontras: cukup ('+Math.round(sd)+')';}
  else{q.className='qchip bad';q.textContent='Kontras: rendah — ganti gambar';}
}
