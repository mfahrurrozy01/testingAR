function bindRange(id,out,fn,fmt){$(id).addEventListener('input',function(){var v=+this.value;$(out).textContent=fmt(v);fn(v);});}
bindRange('rBright','oBright',function(v){S.bright=v/100;},function(v){return v+'%';});
bindRange('rGlow','oGlow',function(v){S.glow=v/100;},function(v){return v+'%';});
bindRange('rKey','oKey',function(v){S.key=v/100;key.intensity=S.key;},function(v){return v+'%';});
bindRange('rScale','oScale',function(v){S.scale=v/100;},function(v){return v+'%';});
bindRange('rSpeed','oSpeed',function(v){S.speed=v/100;},function(v){return (v/100).toFixed(1)+'×';});
