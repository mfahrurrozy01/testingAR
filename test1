  var f=this.files[0]; if(!f) return;
  var img=new Image(),rd=new FileReader();
  rd.onload=function(){img.onload=function(){
    var x=markerCanvas.getContext('2d'); x.fillStyle='#fff'; x.fillRect(0,0,512,512);
    var sc=Math.max(512/img.width,512/img.height),w=img.width*sc,h=img.height*sc;
    x.drawImage(img,(512-w)/2,(512-h)/2,w,h);
    processGrayContrast(); regenMarker(); toast('Marker diganti — cetak ulang versi baru','ok');
  }; img.src=rd.result;};
