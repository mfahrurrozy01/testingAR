/* sheets */
function openSheet(id){$(id).classList.add('open');}
function closeSheet(id){$(id).classList.remove('open');}
$('setupClose').addEventListener('click',function(){closeSheet('setupBackdrop');});
$('helpClose').addEventListener('click',function(){closeSheet('helpBackdrop');});
$('btnHelp').addEventListener('click',function(){openSheet('helpBackdrop');});
[['setupBackdrop'],['helpBackdrop']].forEach(function(a){
  $(a[0]).addEventListener('click',function(e){if(e.target===this)closeSheet(a[0]);});
});
document.addEventListener('keydown',function(e){
  if(e.key==='Escape'){closeSheet('setupBackdrop');closeSheet('helpBackdrop');return;}
  var tag=(e.target.tagName||'').toLowerCase();
  if(tag==='input'||tag==='select'||tag==='textarea'||tag==='button') return;
  if(e.code==='Space'){e.preventDefault();cycleColor();}
  else if(e.key==='r'||e.key==='R'){$('btnReset').click();}
  else if(e.key==='f'||e.key==='F'){screenshot();}
});
/* toast */
function toast(msg,kind){
  var t=document.createElement('div'); t.className='toast'+(kind?' '+kind:''); t.textContent=msg;
  $('toasts').appendChild(t);
  setTimeout(function(){t.style.transition='opacity .4s, transform .4s';t.style.opacity='0';t.style.transform='translateY(10px)';setTimeout(function(){t.remove();},420);},2600);
}

/* ================= MAIN LOOP ================= */
var clock=new THREE.Clock(),frames=0,fpsT=0;
applyColor(S.color,true); applyDisplay(); applyGrid(); syncUI(); setSound(true);
function loop(){
  requestAnimationFrame(loop);
  var dt=Math.min(clock.getDelta(),.05),t=clock.elapsedTime;
  cur.bright+=(S.bright-cur.bright)*.12; cur.glow+=(S.glow-cur.glow)*.12; cur.scale+=(S.scale-cur.scale)*.12;
  if(S.rotate) yaw+=S.speed*dt;
  lamp.rotation.y=yaw; lamp.scale.setScalar(cur.scale);
  var b=cur.bright,p=(Math.sin(t*2.2)+1)/2;
  foundPulse=Math.max(0,foundPulse-dt*1.6);
  var lampVisible=(S.mode==='studio')||markerRoot.visible;
  lampLight.intensity=b*2.4*(lampVisible?1:0);
  coreMat.emissiveIntensity=.4+b*2.2; domeMat.emissiveIntensity=.15+b*.75; ringMat.emissiveIntensity=.3+b*1.3;
  var gs=.14+cur.glow*.16+p*.012+foundPulse*.08;
  glow.scale.set(gs,gs,1); glowMat.opacity=(.15+cur.glow*.55)*(lampVisible?1:0);
  halo.scale.set(gs*2.4,gs*2.4,1); haloMat.opacity=cur.glow*.18*(lampVisible?1:0);
  if(points&&S.particles){
    points.visible=true;
    var pos=pGeo.attributes.position.array;
    for(var i=0;i<pCount;i++){
      pos[i*3+1]+=pVel[i]*dt*(.5+b);
      var a=t*.4+i,sw2=.0006*Math.sin(a);
      pos[i*3]+=sw2; pos[i*3+2]+=sw2*.7;
      if(pos[i*3+1]>.32){pos[i*3+1]=0;}
    }
    pGeo.attributes.position.needsUpdate=true;
    pMat.opacity=.3+b*.6;
  }else if(points){points.visible=false;}
  if(S.mode==='studio'){
    orb.theta+=(orb.tTheta-orb.theta)*.1; orb.phi+=(orb.tPhi-orb.phi)*.1; orb.dist+=(orb.tDist-orb.dist)*.1;
    var drift=(performance.now()-orb.last>4000)?Math.sin(t*.15)*.04:0;
    var th=orb.theta+drift,ph=orb.phi,d=orb.dist;
    studioCam.position.set(d*Math.sin(ph)*Math.sin(th),d*Math.cos(ph),d*Math.sin(ph)*Math.cos(th));
    studioCam.lookAt(0,.06,0);
  }else if(A.source&&A.source.ready&&A.context){
    A.context.update(A.source.domElement);
    setStatus(markerRoot.visible,false);
  }
  if(ambGain&&actx){
    var target=S.sound?(.028+b*.03)*(lampVisible?1:.12):0;
    ambGain.gain.setTargetAtTime(target,actx.currentTime,.25);
  }
  renderer.render(scene,S.mode==='ar'?arCam:studioCam);
  frames++; fpsT+=dt;
  if(fpsT>=.5){$('fps').textContent=Math.round(frames/fpsT)+' fps';frames=0;fpsT=0;}
}
loop();
})();
