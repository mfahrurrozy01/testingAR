}
function rebuildControls(){
  if(!A.context) return;
  try{if(A.controls)A.controls.dispose();}catch(e){}
  A.controls=new THREEx.ArMarkerControls(A.context,markerRoot,{
    type:'pattern',patternUrl:pattUrl,size:S.arSize,changeMatrixMode:'modelViewMatrix',
    smooth:true,smoothCount:5,smoothTolerance:.01,smoothThreshold:2});
  markerRoot.visible=false;
}
function regenMarker(){buildPatt();buildPrintable();rebuildControls();}
drawDefaultArt(); processGrayContrast(); buildPatt(); buildPrintable();

/* ================= AR SESSION ================= */
function loadARjs(){
  if(window.THREEx&&THREEx.ArToolkitContext) return Promise.resolve();
  if(arScriptPromise) return arScriptPromise;
  arScriptPromise=new Promise(function(res,rej){
    var s=document.createElement('script'); s.src=AR_LIB;
    s.onload=function(){res();}; s.onerror=function(){arScriptPromise=null;rej(new Error('Gagal memuat AR.js dari CDN. Periksa koneksi internet.'));};
    document.head.appendChild(s);
  });
  return arScriptPromise;
}
function showSetupErr(msg){var e=$('setupErr');e.innerHTML=msg;e.classList.add('show');}
function clearSetupErr(){$('setupErr').classList.remove('show');}
function arResize(){
  if(S.mode!=='ar'||!A.source||!A.source.ready) return;
  renderer.setSize(stage.clientWidth,stage.clientHeight,false);
  A.source.onResizeElement();
  A.source.copyElementSizeTo(renderer.domElement);
  if(A.context&&A.context.arController) A.source.copyElementSizeTo(A.context.arController.canvas);
}
function enterAR(){
  if(busy||S.mode==='ar') return;
  clearSetupErr();
  if(!window.isSecureContext||!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia){
    showSetupErr('<b>Kamera butuh halaman aman.</b><br>Buka lewat <b>https://</b> atau <b>localhost</b> (contoh: unggah file ini ke GitHub Pages / Netlify, atau jalankan server lokal). Membuka file langsung (file://) tidak bisa mengakses kamera.');
    return;
  }
  busy=true; var b=$('btnStartAR'); b.disabled=true; b.textContent='Menyiapkan kamera…';
  loadARjs().then(function(){
    A.source=new THREEx.ArToolkitSource({sourceType:'webcam',sourceWidth:640,sourceHeight:480,facingMode:'environment'});
    return new Promise(function(res,rej){
      A.source.init(function(){res();},function(err){rej(new Error('Kamera tidak bisa diakses. Izinkan permission kamera, pastikan tidak dipakai aplikasi lain.'));});
    });
  }).then(function(){
    videoWrap.appendChild(A.source.domElement);
    videoWrap.style.display='block';
    A.context=new THREEx.ArToolkitContext({cameraParametersUrl:CAM_PARA,detectionMode:'mono',maxDetectionRate:30,canvasWidth:640,canvasHeight:480});
    return new Promise(function(res){A.context.init(function(){res();});});
  }).then(function(){
    arCam.projectionMatrix.copy(A.context.getProjectionMatrix());
    rebuildControls();
    markerRoot.add(lamp); lamp.position.set(0,0,0);
    S.mode='ar'; document.body.classList.add('ar');
    scene.fog=null; ground.visible=false; grid.visible=false;
    $('btnStudio').setAttribute('aria-pressed','false'); $('btnAR').setAttribute('aria-pressed','true');
    $('arStatus').style.display='flex'; $('arHint').style.display='flex'; $('stageBadge').style.display='none';
    setStatus(false,true);
    closeSheet('setupBackdrop'); arResize(); setTimeout(arResize,600);
    toast('Kamera aktif — arahkan ke marker','ok'); blip(660,.25,.2);
  }).catch(function(err){
    exitAR(true);
    showSetupErr('<b>'+err.message+'</b><br>Tips: pakai Chrome (Android) atau Safari (iOS), izinkan kamera, dan pastikan halaman https/localhost.');
    openSheet('setupBackdrop');
  }).finally(function(){busy=false;b.disabled=false;b.innerHTML='<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg>Nyalakan Kamera & Mulai AR';});
}
function exitAR(silent){
  if(S.mode!=='ar'&&!A.source) return;
  try{if(A.controls)A.controls.dispose();}catch(e){}
  try{if(A.context&&A.context.arController)A.context.arController.dispose();}catch(e){}
  try{if(A.source)A.source.dispose();}catch(e){}
  A={source:null,context:null,controls:null};
  videoWrap.innerHTML=''; videoWrap.style.display='none';
  markerRoot.visible=false;
  studioRoot.add(lamp); lamp.position.set(0,0,0);
  S.mode='studio'; document.body.classList.remove('ar');
  scene.fog=fog; ground.visible=true; applyGrid();
  $('btnStudio').setAttribute('aria-pressed','true'); $('btnAR').setAttribute('aria-pressed','false');
  $('arStatus').style.display='none'; $('arHint').style.display='none'; $('stageBadge').style.display='';
  sizeStudio();
  if(!silent) toast('Kembali ke Studio 3D');
}
var prevFound=false;
function setStatus(found,force){
  if(found===prevFound&&!force) return; prevFound=found;
  var el=$('arStatus');
  el.classList.toggle('ok',found);
  $('arStatusText').textContent=found?'Marker terkunci ✓':'Mencari marker…';
  $('arHint').textContent=found?'Tap layar = ganti warna · seret = putar lampu':'Arahkan kamera ke marker · jarak 20–40 cm · cahaya cukup';
  if(found){blip(880,.2,.18); foundPulse=1; if(navigator.vibrate)navigator.vibrate(35);}
}

/* ================= RESIZE ================= */
function sizeStudio(){
  if(S.mode!=='studio') return;
  var w=stage.clientWidth,h=stage.clientHeight;
  renderer.setSize(w,h,true);
