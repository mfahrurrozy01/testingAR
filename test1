$('btnReset').addEventListener('click',function(){
  Object.assign(S,DEF); key.intensity=S.key; buildParticles(S.density);
  if(points)points.visible=true; applyDisplay(); applyGrid(); syncUI();
  orb.tTheta=.6;orb.tPhi=1.05;orb.tDist=.5; yaw=0; toast('Kembali ke pengaturan awal'); blip(520,.15,.12);
});
$('btnShot').addEventListener('click',screenshot);
